# Copy this file to .env and fill in ONE option.
# .env stays on this Mac only — it is gitignored and must never be shared or screenshotted.

# Option A (recommended): Bedrock API key from the Bedrock console ("API keys" in the left menu)
# AWS_BEARER_TOKEN_BEDROCK=paste-your-long-term-api-key-here
# AWS_REGION=us-east-2

# Option B: classic AWS IAM access keys (only if you already have them)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2

# Option C: Anthropic API key (no AWS account needed)
# ANTHROPIC_API_KEY=
